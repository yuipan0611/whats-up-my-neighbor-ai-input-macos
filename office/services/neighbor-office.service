[Unit]
Description=Neighbor cat office with durable tasks

[Service]
Type=simple
WorkingDirectory=%h/neighbor-office/app
ExecStart=/usr/bin/python3 -I %h/neighbor-office/app/office.py --data %h/neighbor-office/data --model gemma3:4b --port 8421
Restart=on-failure
RestartSec=3
TimeoutStopSec=8
UMask=0077
NoNewPrivileges=true
MemoryMax=1G

[Install]
WantedBy=default.target
