{
  "$defs": {
    "Ack": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "nekochat",
          "title": "Protocol",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "chat.ack",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "delivered",
            "duplicate"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "version",
        "id",
        "kind",
        "status"
      ],
      "title": "Ack",
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "nekochat",
          "title": "Protocol",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "error",
          "title": "Kind",
          "type": "string"
        },
        "code": {
          "enum": [
            "invalid_event",
            "forbidden",
            "offline",
            "rate_limited"
          ],
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "version",
        "id",
        "kind",
        "code"
      ],
      "title": "Error",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "nekochat",
          "title": "Protocol",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "chat.message",
          "title": "Kind",
          "type": "string"
        },
        "sender": {
          "not": {
            "pattern": "[^a-z0-9_-]"
          },
          "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
          "title": "Sender",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "version",
        "id",
        "kind",
        "sender",
        "text"
      ],
      "title": "Message",
      "type": "object"
    },
    "Pong": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "nekochat",
          "title": "Protocol",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "pong",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "version",
        "id",
        "kind"
      ],
      "title": "Pong",
      "type": "object"
    },
    "Ready": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "nekochat",
          "title": "Protocol",
          "type": "string"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        },
        "id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "ready",
          "title": "Kind",
          "type": "string"
        },
        "user": {
          "not": {
            "pattern": "[^a-z0-9_-]"
          },
          "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
          "title": "User",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "version",
        "id",
        "kind",
        "user"
      ],
      "title": "Ready",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "chat.ack": "#/$defs/Ack",
      "chat.message": "#/$defs/Message",
      "error": "#/$defs/Error",
      "pong": "#/$defs/Pong",
      "ready": "#/$defs/Ready"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Ready"
    },
    {
      "$ref": "#/$defs/Message"
    },
    {
      "$ref": "#/$defs/Ack"
    },
    {
      "$ref": "#/$defs/Error"
    },
    {
      "$ref": "#/$defs/Pong"
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
